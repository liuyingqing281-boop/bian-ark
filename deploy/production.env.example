# 生产环境变量模板 —— 复制为 /var/www/bian/.env.production 并填写
# ⚠️ 密钥文件：严禁提交仓库、严禁截图外发

# ---------- 必填（不填影响功能或安全）----------

# 管理员邮箱白名单：生产环境不配置则 admin 全拒绝（fail-closed）
ADMIN_EMAILS=1793092003@qq.com

# SMTP 邮件验证码（不填 = 生产环境无法发验证码 = 无法登录）
SMTP_URL=smtps://1793092003@qq.com:授权码@smtp.qq.com:465
SMTP_FROM=1793092003@qq.com

# 火山方舟（AI 生图 + 数字人视频）
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-4-5-251128
ARK_VIDEO_MODEL=doubao-seedance-2-5-260628
DH_VIDEO_RATIO=9:16
IMAGEGEN_PROVIDER=ark
DIGITALHUMAN_PROVIDER=ark

# 阿里云内容安全（自动审核）
ALIYUN_GREEN_ACCESS_KEY_ID=
ALIYUN_GREEN_ACCESS_KEY_SECRET=

# ---------- 存储（默认本地盘，配好备份即可）----------
STORAGE_PROVIDER=local
DATABASE_PATH=/var/www/bian/data/bian.db
BACKUP_DIR=/data/bian-backups

# ---------- 选填（未办理前留空）----------
# Stripe（海外卡支付；不配则支付入口 503 fail-closed）
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# 微信扫码登录（资质下来后填）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://你的域名/api/auth/wechat/callback

# 微信支付 V3（支付回调必须是公网 HTTPS）
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_NOTIFY_URL=https://bianmuyuan.cn/api/payment/webhook/wechat
WECHAT_PAY_CERT_CACHE_PATH=data/payment/wechat-platform-certs.json

# 支付宝 RSA2（可选）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://bianmuyuan.cn/api/payment/webhook/alipay

# 数字人供应商回调密钥（接真实供应商后配置）
DH_CALLBACK_SECRET=
