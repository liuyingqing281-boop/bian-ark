# 生产环境变量模板 —— 复制为 /var/www/bian/.env.production 并填写
# ⚠️ 密钥文件：严禁提交仓库、严禁截图外发

# ---------- 必填（不填影响功能或安全）----------

# 管理员邮箱白名单：生产环境不配置则 admin 全拒绝（fail-closed）
ADMIN_EMAILS=1793092003@qq.com

# SMTP 邮件验证码（不填 = 生产环境无法发邮箱验证码）
SMTP_URL=smtps://1793092003@qq.com:授权码@smtp.qq.com:465
SMTP_FROM=1793092003@qq.com

# 阿里云短信验证码（2026-08-24 开通；不填 = 生产环境手机号收不到码）
# RAM 子账号 bian-sms（仅 AliyunDysmsFullAccess），签名/模板需在阿里云过审
SMS_PROVIDER=aliyun
SMS_SIGN_NAME=重庆嘟乐慧商贸
SMS_TEMPLATE_CODE=SMS_337746076
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=

# 火山方舟（AI 生图 + 数字人视频）
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-4-5-251128
ARK_VIDEO_MODEL=doubao-seedance-2-5-260628
DH_VIDEO_RATIO=9:16
IMAGEGEN_PROVIDER=ark
DIGITALHUMAN_PROVIDER=ark

# MiMo 语音能力（识别/朗读/音色设计/复刻；不填 = 语音功能整体不可用）
# OpenAI 兼容接口，base 可省略（默认 https://api.xiaomimimo.com/v1）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.xiaomimimo.com/v1

# 阿里云内容安全（自动审核）
ALIYUN_GREEN_ACCESS_KEY_ID=
ALIYUN_GREEN_ACCESS_KEY_SECRET=

# ---------- 存储（默认本地盘，配好备份即可）----------
STORAGE_PROVIDER=local
DATABASE_PATH=/var/www/bian/data/bian.db
BACKUP_DIR=/data/bian-backups

# ---------- 选填（未办理前留空）----------
# Stripe（海外卡支付；不配则支付入口 503 fail-closed）
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# 微信扫码登录（资质下来后填）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://你的域名/api/auth/wechat/callback
WECHAT_MP_TOKEN=

# 数字人供应商回调密钥（接真实供应商后配置）
DH_CALLBACK_SECRET=
