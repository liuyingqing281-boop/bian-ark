# Nginx 反向代理配置模板
# 安装：sudo cp deploy/nginx.conf.template /etc/nginx/sites-available/bian
#       sudo ln -s /etc/nginx/sites-available/bian /etc/nginx/sites-enabled/
#       sudo nginx -t && sudo systemctl reload nginx
#
# 域名就绪前：把 server_name 换成服务器公网 IP 先用 80 端口
# 域名 + ICP 备案就绪后：用 certbot --nginx -d 你的域名 一键加 HTTPS

server {
    listen 80;
    # === 域名就绪前用公网 IP，备案后换成域名 ===
    server_name _;

    # 媒体上传上限（视频 ≤100MB，与 upload.ts 限额一致）
    client_max_body_size 110M;

    # 静态资源（Next 构建产物与用户上传）直接由 nginx 服务可选；
    # 简化起见全部回源 Next，上量后再拆分。
    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 数字人视频生成时间较长，上传与生成接口放宽超时
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Next.js 图片优化服务的内部响应头
    location /_next/image {
        proxy_pass http://127.0.0.1:3002;
        proxy_cache_valid 200 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }
}
