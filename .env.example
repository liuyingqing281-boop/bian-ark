STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxx
STRIPE_PRICE_PREMIUM_YEARLY=price_xxxx
# One-off digital human regeneration (cents, CNY)
STRIPE_PRICE_DH_REDO=
DH_REDO_PRICE_CENTS=2999

# --- P1: auth & uploads ---
# SMTP connection string for email login codes, e.g. smtp://user:pass@smtp.qq.com:465
SMTP_URL=
SMTP_FROM=
# Generic HTTPS webhook for SMS codes (POST {target, code, template}); use Aliyun/Tencent SMS relay
SMS_WEBHOOK_URL=
# WeChat Open Platform website app (scan login, pending approval)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:3003/api/auth/wechat/callback

# --- P2: AI offering image generation ---
# mock (default, local placeholder) | dashscope (Aliyun Tongyi Wanxiang) | ark (Volcano Ark Seedream)
IMAGEGEN_PROVIDER=
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=wanx2.1-t2i-turbo

# --- Volcano Ark (image + video generation) ---
# https://ark.cn-beijing.volces.com/api/v3 — key set = ark wins default provider inference
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-4-5-251128
ARK_VIDEO_MODEL=doubao-seedance-2-5-260628
# Digital-human video defaults (form selectable per task): 9:16 | 16:9
DH_VIDEO_RATIO=9:16
# Optional duration override in seconds (3-12); default auto from script length (5 or 10)
DH_VIDEO_DURATION=

# --- admin & analytics ---
# Comma-separated admin emails; unset = open in dev, closed in production
ADMIN_EMAILS=

# --- content moderation (F1.6) ---
# Aliyun Content Security 2.0 (green-cip); unset = pass-through with manual review
ALIYUN_GREEN_ACCESS_KEY_ID=
ALIYUN_GREEN_ACCESS_KEY_SECRET=

# --- P4: digital human (video avatar) ---
# mock (default, local placeholder) | ark (Volcano Ark Seedance) | guiji | zhiying | xiling
DIGITALHUMAN_PROVIDER=
# Vendor credentials (fill after POC vendor selection)
DH_VENDOR_API_KEY=
DH_VENDOR_APP_ID=
# Shared secret for the vendor webhook /api/digitalhumans/callback
DH_CALLBACK_SECRET=
DH_JOB_TIMEOUT_MINUTES=60

# --- storage ---
# local is supported in this deployment; non-local providers must provide an adapter.
STORAGE_PROVIDER=local
DATABASE_PATH=data/bian.db
BACKUP_DIR=data/backups

# --- unified payments ---
PAYMENT_PROVIDER=
PREMIUM_MONTHLY_PRICE_CENTS=990
PREMIUM_YEARLY_PRICE_CENTS=9900
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL=http://localhost:3003/api/payment/webhook/wechat
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=http://localhost:3003/api/payment/webhook/alipay
