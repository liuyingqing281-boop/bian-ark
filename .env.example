STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxx
STRIPE_PRICE_PREMIUM_YEARLY=price_xxxx
# One-off digital human regeneration (cents, CNY)
STRIPE_PRICE_DH_REDO=
DH_REDO_PRICE_CENTS=2999

# --- P1: auth & uploads ---
# SMTP connection string for email login codes, e.g. smtp://user:pass@smtp.qq.com:465
SMTP_URL=
SMTP_FROM=
# Generic HTTPS webhook for SMS codes (POST {target, code, template}); use Aliyun/Tencent SMS relay
SMS_WEBHOOK_URL=
# WeChat Open Platform website app (scan login, pending approval)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# --- P2: AI offering image generation ---
# mock (default, local placeholder) | dashscope (Aliyun Tongyi Wanxiang)
IMAGEGEN_PROVIDER=
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=wanx2.1-t2i-turbo

# --- admin & analytics ---
# Comma-separated admin emails; unset = open in dev, closed in production
ADMIN_EMAILS=

# --- content moderation (F1.6) ---
# Aliyun Content Security 2.0 (green-cip); unset = pass-through with manual review
ALIYUN_GREEN_ACCESS_KEY_ID=
ALIYUN_GREEN_ACCESS_KEY_SECRET=

# --- P4: digital human (video avatar) ---
# mock (default, local placeholder) | guiji | zhiying | xiling
DIGITALHUMAN_PROVIDER=
# Vendor credentials (fill after POC vendor selection)
DH_VENDOR_API_KEY=
DH_VENDOR_APP_ID=
# Shared secret for the vendor webhook /api/digitalhumans/callback
DH_CALLBACK_SECRET=
